# SecondBrain Environment Variables
# Copy this file to .env and fill in your values

# Notion API
NOTION_TOKEN=your_notion_integration_token

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Notion Database IDs (can be URLs or UUIDs)
CAPTURE_INBOX_DB_ID=your_capture_inbox_database_id
PEOPLE_DB_ID=your_people_database_id
IDEAS_DB_ID=your_ideas_database_id
ADMIN_DB_ID=your_admin_database_id
KNOWLEDGE_BASE_DB_ID=your_knowledge_base_database_id

# Neo4j AuraDB
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
